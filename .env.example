# ── WII SPORTS CLUB — NEX game server ───────────────────────────────────────
#
# Copy to .env and edit. Every variable marked REQUIRED must be set.

# REQUIRED. Postgres connection string.
PN_POSTGRES_URI=postgres://wsc:wscpass@127.0.0.1:5432/wsc?sslmode=disable

# Password for the two internal Quazal server accounts. Defaults to a
# well-known placeholder if unset — set this for anything beyond local
# testing.
PN_KERBEROS_PASSWORD=

# REQUIRED. UDP port for the authentication server.
PN_AUTHENTICATION_SERVER_PORT=60000

# REQUIRED. The address consoles will use to reach the secure server. This is
# handed to the console verbatim during login, so it must be routable *from
# the console* — a LAN IP, a public IP or a hostname.
PN_SECURE_SERVER_HOST=192.168.1.10

# REQUIRED. UDP port for the secure server.
PN_SECURE_SERVER_PORT=60001

# REQUIRED. 64-character hex AES-256 key used to validate NEX tokens.
PN_NEX_TOKEN_AES_KEY=

# REQUIRED. At least 32 bytes, hex-encoded. Used to derive a stable per-PID
# NEX password without storing credentials — whatever account server issues
# NEX tokens must derive passwords from the same secret.
PN_NEX_PASSWORD_SECRET=
